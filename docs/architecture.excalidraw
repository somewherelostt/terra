      "link": null,
      "locked": false,
      "text": "Honest limits",
      "fontSize": 26,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Honest limits",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4K8CplXIQ9Vb_Qnn50hWP",
      "type": "text",
      "x": 64,
      "y": 1746,
      "width": 1148.7021484375,
      "height": 23.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1K",
      "roundness": null,
      "seed": 131032460,
      "version": 2,
      "versionNonce": 919455372,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794688693181,
      "link": null,
      "locked": false,
      "text": "· Tier limits are checked by Terra, not by the DAO contract. On chain, one trusted vote can approve a transfer of any size, so keep the trusted list small.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "· Tier limits are checked by Terra, not by the DAO contract. On chain, one trusted vote can approve a transfer of any size, so keep the trusted list small.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "TjPHVEHOsyVw1LFnYNZa-",
      "type": "text",
      "x": 64,
      "y": 1778,
      "width": 745.564453125,
      "height": 23.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1L",
      "roundness": null,
      "seed": 728533300,
      "version": 2,
      "versionNonce": 985708596,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794688693181,
      "link": null,
      "locked": false,
      "text": "· The allowance contract is the hard, on-chain cap: daily cap, per-payment max, expiry and freeze.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "· The allowance contract is the hard, on-chain cap: daily cap, per-payment max, expiry and freeze.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dHNOf04aZOPRuP9vQaHD1",
      "type": "text",
      "x": 64,
      "y": 1810,
      "width": 1238.1357421875,
      "height": 23.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1M",
      "roundness": null,
      "seed": 1986188300,
      "version": 2,
      "versionNonce": 1491932428,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794688693181,
      "link": null,
      "locked": false,
      "text": "· Cross-chain: the app makes live dry quotes (NEAR Intents has no testnet); a real mainnet payout goes through a keyless script, sent from the person's own wallet.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "· Cross-chain: the app makes live dry quotes (NEAR Intents has no testnet); a real mainnet payout goes through a keyless script, sent from the person's own wallet.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "y2ek0_9GCyj1vToUUDkes",
      "type": "text",
      "x": 64,
      "y": 1842,
      "width": 723.9482421875,
      "height": 23.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1N",
      "roundness": null,
      "seed": 887964340,
      "version": 2,
      "versionNonce": 1206096308,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794688693181,
      "link": null,
      "locked": false,
      "text": "· DMs: message bodies are end-to-end encrypted, but who wrote to whom, and when, is public.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "· DMs: message bodies are end-to-end encrypted, but who wrote to whom, and when, is public.",
      "autoResize": true,
      "lineHeight": 1.25
    },
